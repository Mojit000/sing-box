{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "secret": "",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "direct",
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_rdrc": true
    }
  },
  "dns": {
    "servers": [{
        "tag": "proxy_dns",
        "type": "https",
        "server": "dns.google",
        "path": "/dns-query",
        "detour": "🍀𝕌𝕝𝕥𝕚𝕞𝕒𝕥𝕖"
      },
      {
        "tag": "cn_dns",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "fake_dns",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [{
        "rule_set": "anti-ad",
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "cn_dns"
      },
      {
        "clash_mode": "Global",
        "server": "proxy_dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [{
            "domain_suffix": ["onejailbreak.com", ".cn"]
          },
          {
            "domain_keyword": ["stun", "turn"]
          },
          {
            "rule_set": "cnsite"
          }
        ],
        "server": "cn_dns"
      },
      {
        "query_type": ["A", "AAAA"],
        "server": "fake_dns",
        "rewrite_ttl": 1
      }
    ],
    "final": "proxy_dns",
    "strategy": "prefer_ipv4",
    "independent_cache": true,
    "cache_capacity": 8192
  },
  "inbounds": [{
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singbox_tun",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 9000,
      "auto_route": true,
      "route_exclude_address": ["10.0.0.0/8", "100.64.0.0/10", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.168.0.0/16"],
      "route_exclude_address_set": ["cnip"],
      "strict_route": true,
      "endpoint_independent_nat": false,
      "stack": "mixed"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "route": {
    "final": "🍀𝕌𝕝𝕥𝕚𝕞𝕒𝕥𝕖",
    "auto_detect_interface": true,
    "default_domain_resolver": "cn_dns",
    "rules": [{
        "type": "logical",
        "mode": "and",
        "rules": [{
            "port": 443
          },
          {
            "network": "udp"
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [{
            "ip_version": 6
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "network": "icmp",
        "outbound": "Direct"
      },
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [{
            "protocol": "dns"
          },
          {
            "port": [53, 853]
          }
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": "anti-ad",
        "action": "reject"
      },
      {
        "ip_is_private": true,
